# Скопируйте в .env и заполните. Файл .env не публикуйте и храните копию отдельно от сервера.
# Сгенерировать значения: openssl rand -hex 32
POSTGRES_USER=rxguard
POSTGRES_PASSWORD=СМЕНИТЕ_НА_СЛУЧАЙНОЕ
POSTGRES_DB=rxguard
N8N_ENCRYPTION_KEY=СМЕНИТЕ_НА_СЛУЧАЙНОЕ_И_НЕ_МЕНЯЙТЕ
HOST=rx.example-optics.ru
TZ=Europe/Moscow
TUNNEL_TOKEN=ВСТАВЬТЕ_ТОКЕН_ТУННЕЛЯ_CLOUDFLARE
# Токен бота создаётся у BotFather и вносится в учётные данные Telegram в n8n (не в .env)
# Чат, куда бот присылает карточки врачу (chat_id), и список Telegram id врачей, которым разрешено нажимать «Подтвердить» (через запятую)
ADMIN_CHAT_ID=0
RX_DOCTOR_IDS=0
# Чаты мастеров, которым разрешено присылать фото бланков (chat_id через запятую). Чужие чаты бот игнорирует
RX_CHAT_IDS=0
# Мультимодальная модель Ollama (пример, не проверялась): подберите по железу и проверьте точность на своих бланках
OLLAMA_VL_MODEL=qwen2.5vl:7b
